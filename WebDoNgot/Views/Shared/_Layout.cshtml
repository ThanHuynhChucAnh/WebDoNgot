<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebDoNgot Bakery</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebDoNgot.styles.css" asp-append-version="true" />

    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
            :root {
                --primary-bakery: #9E6B75;
                --primary-hover: #855660;
                --accent-pink: #F7EBEF;
                --text-dark: #4A3E41;
                --text-muted: #8A7A7D;
                --bg-light: #FAF7F5;
            }

            body {
                background-color: var(--bg-light);
                color: var(--text-dark);
                font-family: 'Plus Jakarta Sans', sans-serif;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* Tinh chỉnh thanh Navbar cao cấp */
            .bakery-navbar {
                background-color: #FFFFFF !important;
                box-shadow: 0 4px 20px rgba(158, 107, 117, 0.05) !important;
                padding: 14px 0;
                border: none !important;
            }

            .bakery-brand {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                font-size: 1.45rem;
                color: var(--primary-bakery) !important;
                display: flex;
                align-items: center;
                gap: 8px;
                letter-spacing: 0.5px;
            }

            .bakery-brand i {
                font-size: 1.3rem;
            }

            /* Định hình các nút Menu điều hướng chính - Mặc định chữ màu đen */
            .bakery-nav-link {
                color: var(--text-dark) !important; /* Đảm bảo màu gốc là màu nâu đen */
                font-weight: 500;
                font-size: 0.95rem;
                padding: 8px 16px !important;
                border-radius: 10px;
                transition: all 0.2s ease-in-out;
                display: flex;
                align-items: center;
                gap: 6px;
                text-decoration: none;
            }

            .bakery-nav-link:hover {
                background-color: var(--accent-pink);
                color: var(--primary-bakery) !important; /* Di chuột vào hóa hồng */
            }

            /* Đánh dấu trang hiện tại hoạt động sinh động */
            .bakery-nav-item.active .bakery-nav-link {
                background-color: var(--accent-pink);
                color: var(--primary-bakery) !important;
                font-weight: 600;
            }

            /* Khung nội dung chính mượt mà */
            .bakery-container {
                flex: 1;
            }

            /* Footer phong cách nhẹ nhàng đồng bộ */
            .bakery-base-footer {
                background-color: #FFFFFF;
                border-top: 1px solid rgba(158, 107, 117, 0.1) !important;
                color: var(--text-muted);
                font-size: 0.85rem;
                padding: 15px 0;
            }

            .bakery-base-footer a {
                color: var(--primary-bakery);
                text-decoration: none;
                font-weight: 500;
            }

            .bakery-base-footer a:hover {
                text-decoration: underline;
                color: var(--primary-hover);
            }

            /* Custom lại thanh cuộn trình duyệt cho mượt */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: var(--bg-light);
            }
            ::-webkit-scrollbar-thumb {
                background: #D1C4C6;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: var(--primary-bakery);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bakery-navbar">
            <div class="container">
                <a class="navbar-brand bakery-brand" asp-area="" asp-controller="Product" asp-action="Index">
                    <i class="fa-solid fa-stroopwafel"></i>WebDoNgot
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1 ms-sm-3">
                        <li class="nav-item bakery-nav-item">
                            <a class="nav-link bakery-nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="fa-solid fa-cake-candles"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item bakery-nav-item">
                            <a class="nav-link bakery-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="fa-solid fa-shield-halved"></i>Bảo mật
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center mt-3 mt-sm-0">
                        <partial name="_LoginPartial" />

                      <div class="d-flex">
                          <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-dark d-flex align-items-center position-relative">
                              <i class="bi-cart-fill me-1"></i>
                              Giỏ hàng
                              <span class="badge bg-danger position-absolute" style="top:-6px; right:-6px;" id="cart-count">0</span>
                          </a>
                      </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container bakery-container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bakery-base-footer text-center">
        <div class="container">
            &copy; @DateTime.Now.Year - <span class="fw-bold" style="color: var(--primary-bakery);">WebDoNgot Bakery</span>. Thiết kế tinh tế cho trải nghiệm ngọt ngào. - <a asp-area="" asp-controller="Product" asp-action="Privacy">Chính sách bảo mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const currentUrl = window.location.pathname.toLowerCase();
                const navLinks = document.querySelectorAll('.bakery-nav-link');
            
                navLinks.forEach(link => {
                    const linkHref = link.getAttribute('href').toLowerCase();
                    // Chuẩn hóa kiểm tra active chính xác cho trang chủ "/" và các trang con
                    if ((linkHref === '/' && currentUrl === '/') ||
                        (linkHref !== '/' && (currentUrl === linkHref || currentUrl.startsWith(linkHref + '/')))) {
                        link.parentElement.classList.add('active');
                    } else {
                        link.parentElement.classList.remove('active');
                    }
                });
            });

            // Load cart count from session via an endpoint
            async function loadCartCount() {
                try {
                    const resp = await fetch('/api/cart/count');
                    if (!resp.ok) return;
                    const data = await resp.json();
                    const badge = document.getElementById('cart-count');
                    if (badge) badge.textContent = data.count || 0;
                } catch { }
            }

            loadCartCount();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>