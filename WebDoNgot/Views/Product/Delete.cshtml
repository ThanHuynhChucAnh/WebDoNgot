@model WebDoNgot.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card p-5 text-center shadow-sm" style="border: none; border-radius: 24px; max-width: 500px; background: white;">
        <div class="mb-4" style="font-size: 3rem;">⚠️</div>
        <h3 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #4A3E41;">Xóa sản phẩm?</h3>
        <p class="text-muted my-3 px-3">
            Bạn có chắc muốn xóa sản phẩm này <strong>@Model.Name</strong> from the showcase? This action cannot be undone.
        </p>

        <form asp-action="DeleteConfirmed" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-3 justify-content-center">
                <a asp-action="Index" class="btn btn-light px-4 py-2.5" style="border-radius: 12px; width: 120px;">Hủy</a>
                <button type="submit" class="btn btn-danger px-4 py-2.5" style="border-radius: 12px; width: 120px; background-color: #D9534F;">Xóa</button>
            </div>
        </form>
    </div>
</div>