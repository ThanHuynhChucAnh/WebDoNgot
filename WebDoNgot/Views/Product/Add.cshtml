@model WebDoNgot.Models.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border rounded p-4 shadow-sm bg-light">
            <h2 class="text-center mb-4 text-primary">Thêm sản phẩm mới</h2>

            <form asp-action="Add" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label font-weight-bold">Giá bán</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label font-weight-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label font-weight-bold">Danh mục</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-control"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Hình ảnh đại diện</label>
                    <input type="file" name="imageUrl" class="form-control" accept="image/*" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                    <button type="submit" class="btn btn-primary px-4">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>