@model WebDoNgot.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<style>
    :root {
        --primary-bakery: #9E6B75;
        --accent-pink: #FDF6F8;
        --text-dark: #4A3E41;
        --bg-light: #FAF7F5;
    }

    body {
        background-color: var(--bg-light);
        color: var(--text-dark);
    }

    .display-card {
        background: white;
        border: none;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(158, 107, 117, 0.04);
        overflow: hidden;
    }

    .details-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--text-dark);
    }

    .price-large {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--primary-bakery);
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">&larr; Quay lại</a>
    </div>

    <div class="card display-card p-4">
        <div class="row g-5 align-items-center">
            <div class="col-md-5 text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid shadow-sm" style="border-radius: 20px; max-height: 400px; width: 100%; object-fit: cover;" />
                }
            </div>
            <div class="col-md-7">
                <span class="badge mb-2" style="background-color: var(--accent-pink); color: var(--primary-bakery); padding: 6px 16px; border-radius: 20px; font-weight: 600;">
                    @(Model.Category?.Name ?? "Product Details")
                </span>
                <h1 class="details-title mb-3">@Model.Name</h1>
                <div class="price-large mb-4">@(Model.Price.ToString("#,##0"))đ</div>

                <h5 class="font-weight-bold" style="color: #7A6B6E;">Description</h5>
                <p class="text-muted lh-lg">@Model.Description</p>

                <div class="mt-5 pt-3 border-top d-flex gap-2">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-dark px-4" style="border-radius: 12px;">Sửa sản phẩm</a>
                </div>
            </div>
        </div>
    </div>
</div>