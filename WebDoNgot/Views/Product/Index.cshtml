@model IEnumerable<WebDoNgot.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-bakery: #9E6B75;
        --primary-hover: #855660;
        --accent-pink: #F7EBEF;
        --active-pink-bg: #E8C5CC;
        --text-dark: #4A3E41;
        --text-muted: #8A7A7D;
        --bg-light: #FAF7F5;
        --sidebar-text: #635759;
        /* Màu sắc mềm mại cho các nút hành động */
        --btn-view-bg: #F0ECE9;
        --btn-edit-bg: #EAE0E2;
        --btn-delete-bg: #FCECEE;
        --btn-delete-text: #C75A6B;
    }

    body {
        background-color: var(--bg-light);
        color: var(--text-dark);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Cấu trúc Sidebar */
    .sidebar {
        background-color: #FAF7F5;
        padding: 20px 10px;
        min-height: calc(100vh - 60px);
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sidebar-item a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 20px;
        color: var(--sidebar-text);
        text-decoration: none;
        font-weight: 500;
        border-radius: 14px;
        transition: all 0.2s ease-in-out;
    }

        .sidebar-item a:hover {
            background-color: rgba(158, 107, 117, 0.05);
            color: var(--primary-bakery);
        }

    .sidebar-item.active a {
        background-color: var(--accent-pink);
        color: var(--primary-bakery);
        font-weight: 600;
    }

    .sidebar-item i {
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
    }

    /* Khối nội dung chính bên phải */
    .main-content {
        background-color: #FAF7F5;
        padding: 25px;
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 60px);
    }

    .page-header {
        border-bottom: 2px solid var(--accent-pink);
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

    /* KHỐI HERO BANNER LỚN PHÍA TRÊN */
    .bakery-hero-banner {
        position: relative;
        background: linear-gradient(135deg, #F3E6E8 0%, #E3CDD2 100%);
        border-radius: 24px;
        overflow: hidden;
        min-height: 280px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 30px rgba(158, 107, 117, 0.08);
    }

    .hero-text-side {
        position: relative;
        z-index: 2;
        max-width: 55%;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: #4A3E41;
        font-size: 2.2rem;
        line-height: 1.3;
    }

    .hero-badge {
        display: inline-block;
        background-color: rgba(255, 255, 255, 0.6);
        color: var(--primary-bakery);
        padding: 4px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Ảnh nền Macaron bự tràn lề phải mượt mà */
    .hero-image-side {
        position: absolute;
        right: 0;
        bottom: -20px;
        top: -20px;
        width: 50%;
        background-image: url('https://images.unsplash.com/photo-1569864358642-9d1684040f43?auto=format&fit=crop&w=800&q=80');
        background-size: cover;
        background-position: center;
        mask-image: linear-gradient(to left, rgba(0,0,0,1) 75%, rgba(0,0,0,0) 100%);
        -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,1) 75%, rgba(0,0,0,0) 100%);
    }

    /* Nút thêm sản phẩm mới */
    .btn-bakery-primary {
        background-color: var(--primary-bakery);
        color: white;
        border-radius: 20px;
        padding: 10px 24px;
        border: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-bakery-primary:hover {
            background-color: var(--primary-hover);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(158, 107, 117, 0.2);
        }

    /* Thẻ thống kê nhanh */
    .stat-card {
        background: white;
        border: none;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 4px 15px rgba(158, 107, 117, 0.03);
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background-color: var(--accent-pink);
        color: var(--primary-bakery);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    /* Lưới sản phẩm dạng thẻ (Card Grid) */
    .product-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(158, 107, 117, 0.04);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
        height: 100%;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(158, 107, 117, 0.12);
        }

    .product-img-wrapper {
        position: relative;
        height: 190px;
        background-color: var(--accent-pink);
        overflow: hidden;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.06);
    }

    .category-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(255, 255, 255, 0.95);
        color: var(--primary-bakery);
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .card-title-bakery {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--text-dark);
    }

    /* Thiết kế khu vực giá tiền tinh tế */
    .price-container {
        background-color: rgba(250, 247, 245, 0.8);
        padding: 6px 12px;
        border-radius: 10px;
    }

    .price-tag {
        color: var(--primary-bakery);
        font-weight: 800;
        font-size: 1.15rem;
    }

    /* Tinh chỉnh lại các nút hành động (Xem, Sửa, Xóa) */
    .action-links .btn-action {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: none;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-view {
        background-color: var(--btn-view-bg);
        color: var(--text-dark);
    }

        .btn-view:hover {
            background-color: #E2DBD8;
            color: #000;
        }

    .btn-edit {
        background-color: var(--btn-edit-bg);
        color: var(--primary-bakery);
    }

        .btn-edit:hover {
            background-color: var(--active-pink-bg);
            color: var(--primary-hover);
        }

    .btn-delete {
        background-color: var(--btn-delete-bg);
        color: var(--btn-delete-text);
    }

        .btn-delete:hover {
            background-color: #F7D4D9;
            color: #A53B4C;
        }

    /* THIẾT KẾ KHỐI LIÊN HỆ PHÍA DƯỚI (CONTACT FOOTER) */
    .bakery-footer {
        background-color: white;
        border-radius: 24px;
        box-shadow: 0 4px 20px rgba(158, 107, 117, 0.03);
        border: 1px solid var(--accent-pink);
    }

    .footer-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--primary-bakery);
        font-size: 1.3rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--text-dark);
        font-size: 0.9rem;
    }

        .contact-item i {
            color: var(--primary-bakery);
            width: 20px;
            text-align: center;
        }

    .social-links a {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-light);
        color: var(--primary-bakery);
        border-radius: 50%;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .social-links a:hover {
            background-color: var(--primary-bakery);
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 col-lg-2 sidebar border-end">
            <ul class="sidebar-menu">
                <li class="sidebar-item active">
                    <a asp-controller="Product" asp-action="Index"><i class="fa-solid fa-chart-pie"></i>Sản phẩm</a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Category" asp-action="Index"><i class="fa-solid fa-box"></i>Danh mục</a>
                </li>
            </ul>
        </div>

        <div class="col-md-9 col-lg-10 main-content">

            <div class="bakery-hero-banner p-5 mb-5">
                <div class="hero-text-side">
                    <span class="hero-badge mb-2">Bộ Sưu Tập Mùa Xuân</span>
                    <h1 class="hero-title mb-3">Kiệt Tác Trong Từng Chi Tiết</h1>
                    <p class="text-muted mb-4 d-none d-sm-block" style="font-size: 0.95rem; line-height: 1.5;">
                        Trải nghiệm sự tinh tế từ những chiếc bánh ngọt thủ công, nơi kỹ nghệ Pháp truyền thống hòa quyện cùng cảm hứng hiện đại.
                    </p>
                    <a asp-action="Add" class="btn btn-bakery-primary shadow-sm">
                        <i class="fa-solid fa-plus"></i> Thêm sản phẩm mới
                    </a>
                </div>
                <div class="hero-image-side"></div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="card-title-bakery m-0" style="font-size: 1.4rem;">Tổng quan</h4>
            </div>

            <div class="row g-3 mb-5">
                <div class="col-6 col-sm-3">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-cake-candles"></i></div>
                        <div>
                            <div class="text-muted small">Tổng sản phẩm</div>
                            <h4 class="fw-bold m-0 text-dark">@Model.Count()</h4>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background-color: #EBF7ED; color: #56A366;"><i class="fa-solid fa-tags"></i></div>
                        <div>
                            <div class="text-muted small">Danh mục</div>
                            <h4 class="fw-bold m-0 text-dark">@(ViewBag.TotalCategoriesCount ?? 0)</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
                @if (!Model.Any())
                {
                    <div class="col-12 text-center py-5">
                        <div class="text-muted mb-3"><i class="fa-regular fa-folder-open fa-3x"></i></div>
                        <p class="text-muted">Không tìm thấy món bánh nào phù hợp.</p>
                    </div>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card product-card">
                                <div class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="product-img" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="font-size: 0.85rem;">
                                            <i class="fa-regular fa-image me-1"></i> Không có ảnh
                                        </div>
                                    }
                                    <span class="category-badge shadow-sm">@(product.Category?.Name ?? "Bánh")</span>
                                </div>

                                <div class="card-body d-flex flex-column p-3">
                                    <h5 class="card-title-bakery text-truncate mb-1" style="font-size: 1.05rem;" title="@product.Name">@product.Name</h5>
                                    <p class="card-text text-muted mb-3" style="font-size: 0.85rem; height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3;">
                                        @product.Description
                                    </p>

                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <div class="price-container">
                                            <span class="price-tag">@(product.Price.ToString("#,##0"))đ</span>
                                        </div>

                                        <div class="action-links d-flex gap-1">
                                            <a asp-action="Display" asp-route-id="@product.Id" class="btn-action btn-view" title="Xem chi tiết">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a asp-action="Update" asp-route-id="@product.Id" class="btn-action btn-edit" title="Chỉnh sửa">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn-action btn-delete" title="Xóa sản phẩm">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <footer class="bakery-footer p-4 mt-auto">
                <div class="row align-items-center gy-3">
                    <div class="col-md-4 text-center text-md-start">
                        <div class="footer-brand mb-1">
                            <i class="fa-solid fa-stroopwafel me-2"></i>WebDoNgot Bakery
                        </div>
                        <p class="text-muted small mb-0">Hương vị ngọt ngào, đong đầy hạnh phúc trong từng lát bánh.</p>
                    </div>

                    <div class="col-md-5">
                        <div class="d-flex flex-column gap-2 justify-content-center h-100 ps-md-4">
                            <div class="contact-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>Thành phố Hồ Chí Minh, Việt Nam</span>
                            </div>
                            <div class="contact-item">
                                <i class="fa-solid fa-phone"></i>
                                <span>+0123456789</span>
                            </div>
                            <div class="contact-item">
                                <i class="fa-solid fa-envelope"></i>
                                <span>contact@webdongot.com</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 text-center text-md-end">
                        <div class="mb-2 text-muted small fw-bold text-uppercase">Kết nối với chúng tôi</div>
                        <div class="social-links d-flex gap-2 justify-content-center justify-content-md-end">
                            <a href="#" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="#" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a href="#" title="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        </div>
                    </div>
                </div>
                <hr style="border-top: 1px solid var(--accent-pink); margin: 15px 0 0 0;">
                <div class="text-center text-muted mt-2" style="font-size: 0.75rem;">
                    &copy; @DateTime.Now.Year WebDoNgot Bakery. All rights reserved.
                </div>
            </footer>

        </div>
    </div>
</div>