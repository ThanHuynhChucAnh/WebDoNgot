@model IEnumerable<WebDoNgot.Models.Product>
@{
    ViewData["Title"] = "Cửa Hàng Đồ Ngọt";
}

<div class="container-fluid px-0 mb-5">
    <div id="storeBannerCarousel" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden mx-auto" data-bs-ride="carousel" style="max-width: 1300px;">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#storeBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#storeBannerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#storeBannerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner" style="height: 380px;">
            <div class="carousel-item active" data-bs-interval="4000">
                <img src="https://images.unsplash.com/photo-1517433367423-c7e5b0f35086?q=80&w=1500&auto=format&fit=crop" class="d-block w-100 h-100 object-fit-cover" alt="Khai xuân ngọt ngào">
                <div class="carousel-caption d-none d-md-block text-start start-10 bottom-25 style-caption">
                    <span class="badge bg-warning text-white px-3 py-2 rounded-pill mb-2 fw-bold text-uppercase tracking-wider">Sweet Season</span>
                    <h2 class="display-5 fw-bold text-white drop-shadow">Khai Xuân Ngọt Ngào</h2>
                    <p class="fs-5 text-white-50">Ngập tràn quà tặng giá trị & Vạn lời tri ân từ tiệm bánh</p>
                </div>
            </div>
            <div class="carousel-item" data-bs-interval="4000">
                <img src="https://bizweb.dktcdn.net/100/518/288/files/cac-loai-keo-pho-bien-tren-the-gioi.jpg?v=1726114169111" class="d-block w-100 h-100 object-fit-cover" alt="Món ngọt mới ra mắt">
                <div class="carousel-caption d-none d-md-block text-start start-10 bottom-25 style-caption">
                    <span class="badge bg-danger text-white px-3 py-2 rounded-pill mb-2 fw-bold text-uppercase tracking-wider">New Arrival</span>
                    <h2 class="display-5 fw-bold text-white drop-shadow">Thực Đơn Mùa Hè</h2>
                    <p class="fs-5 text-white-50">Hương vị thanh mát, giải nhiệt cực đã từ trái cây nhiệt đới</p>
                </div>
            </div>
            <div class="carousel-item" data-bs-interval="4000">
                <img src="https://cdn2.fptshop.com.vn/unsafe/1920x0/filters:format(webp):quality(75)/banh_keo_my_xach_tay_3aa4d383f2.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Ưu đãi thành viên">
                <div class="carousel-caption d-none d-md-block text-start start-10 bottom-25 style-caption">
                    <span class="badge bg-info text-white px-3 py-2 rounded-pill mb-2 fw-bold text-uppercase tracking-wider">Member Only</span>
                    <h2 class="display-5 fw-bold text-white drop-shadow">Ưu Đãi Thành Viên</h2>
                    <p class="fs-5 text-white-50">Tích điểm đổi quà - Giảm ngay 15% cho hóa đơn sinh nhật</p>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#storeBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#storeBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
<div class="container mb-4">
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary rounded-pill px-4 active" asp-controller="Product" asp-action="Index">
            <i class="bi bi-box-seam"></i> Quản lý Sản phẩm
        </a>
        <a class="btn btn-outline-secondary rounded-pill px-4" asp-controller="Category" asp-action="Index">
            <i class="bi bi-tag"></i> Quản lý Danh mục
        </a>
    </div>
</div>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">🍰 Quản Lý Thực Đơn</h2>
            <p class="text-muted small mb-0">Xem, cập nhật và quản lý danh sách bánh ngọt trong hệ thống</p>
        </div>
        <a asp-action="Add" class="btn btn-gradient-primary px-4 py-2 shadow-sm rounded-pill fw-bold text-white">
            <i class="bi bi-plus-circle-fill me-2"></i>Thêm sản phẩm mới
        </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 rounded-4 custom-card bg-white">

                        <div class="card-img-wrapper position-relative m-3 rounded-4 bg-light overflow-hidden" style="height: 180px;">
                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.png" : product.ImageUrl)"
                                 alt="@product.Name"
                                 class="w-100 h-100 custom-img"
                                 onerror="this.onerror=null; this.src='/images/no-image.png';" />
                        </div>

                        <div class="card-body d-flex flex-column pt-1 px-4 pb-3">
                            <h5 class="card-title fw-bold text-dark text-truncate mb-1" title="@product.Name">
                                @product.Name
                            </h5>

                            <p class="card-text text-muted small lh-sm mb-3" style="height: 36px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(product.Description) ? "Chưa có mô tả ngắn cho sản phẩm." : product.Description)
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
                                <span class="text-danger fw-bolder fs-5">@product.Price.ToString("#,##0") đ</span>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                            <div class="d-flex gap-2">
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-action btn-light flex-grow-1 text-dark text-center" title="Chi tiết">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-action btn-warning-soft flex-grow-1 text-warning text-center" title="Sửa">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-action btn-danger-soft flex-grow-1 text-danger text-center" title="Xóa">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox text-muted fs-1 d-block mb-3"></i>
                <p class="text-muted fs-5">Hiện chưa có món ngọt nào trong thực đơn.</p>
            </div>
        }
    </div>
</div>



<style>
    body {
        background-color: #f8f9fa;
    }
    /* Bo góc tùy chỉnh cho Carousel */
    .rounded-4 {
        border-radius: 16px !important;
    }
    /* Ép ảnh vừa khít khung banner */
    .object-fit-cover {
        object-fit: cover;
    }
    /* Đổ bóng cho chữ trên banner dễ đọc */
    .drop-shadow {
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }
    /* Hộp nền mờ chữ cho text trên banner */
    .style-caption {
        background: linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        padding-left: 5% !important;
        padding-bottom: 4% !important;
        width: 100%;
    }
    /* Nút gradient */
    .btn-gradient-primary {
        background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
        border: none;
        transition: transform 0.2s ease, opacity 0.2s;
    }

        .btn-gradient-primary:hover {
            transform: translateY(-2px);
            opacity: 0.95;
            color: white;
        }
    /* Thẻ card sản phẩm */
    .custom-card {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s ease;
    }

        .custom-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(255, 117, 140, 0.12);
        }

    .custom-img {
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .custom-card:hover .custom-img {
        transform: scale(1.06);
    }
    /* Nút bấm hành động nhỏ */
    .btn-action {
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 8px 12px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-warning-soft {
        background-color: #fff9e6;
    }

        .btn-warning-soft:hover {
            background-color: #ffc107;
            color: #fff !important;
        }

    .btn-danger-soft {
        background-color: #ffebe6;
    }

        .btn-danger-soft:hover {
            background-color: #dc3545;
            color: #fff !important;
        }

    .btn-light:hover {
        background-color: #e2e6ea;
    }
    /* Tùy chỉnh thanh điều hướng dạng Pills */
    .btn-outline-primary {
        border-color: #ff758c;
        color: #ff758c;
    }

        .btn-outline-primary:hover, .btn-outline-primary.active {
            background-color: #ff758c;
            color: #fff;
            border-color: #ff758c;
        }

    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: #fff;
        }
</style>