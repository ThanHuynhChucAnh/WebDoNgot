@model WebDoNgot.Models.Product
@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border rounded p-4 shadow-sm bg-light">
            <h2 class="text-center mb-4 text-warning">Chỉnh sửa sản phẩm</h2>

            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label font-weight-bold">Giá bán (đ)</label>
                    <input asp-for="Price" class="form-control" type="number" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label font-weight-bold">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold d-block">Hình ảnh sản phẩm</label>

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-3 text-center bg-white p-2 border rounded" style="max-width: 180px; margin: 0 auto;">
                            <span class="text-muted small d-block mb-1">Ảnh hiện tại:</span>
                            <img src="@Model.ImageUrl" alt="Current Image" class="img-thumbnail" style="max-height: 120px; object-fit: cover;" />
                        </div>
                    }

                    <div class="input-group">
                        <input type="file" name="imageUrl" class="form-control" accept="image/*" />
                    </div>
                    <span class="text-muted small">Để trống nếu bạn muốn giữ nguyên hình ảnh hiện tại.</span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning px-4 text-white">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>