    @model WebDoNgot.Models.ShoppingCart

    @{
        ViewData["Title"] = "Giỏ hàng";
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-bakery: #9E6B75;
            --primary-hover: #855660;
            --accent-pink: #F7EBEF;
            --active-pink-bg: #E8C5CC;
            --text-dark: #4A3E41;
            --text-muted: #8A7A7D;
            --bg-light: #FAF7F5;
        }

        body {
            background-color: #FCF9F7;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-dark);
        }

        .cart-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: var(--text-dark);
            font-size: 2rem;
        }

        .bakery-cart-card {
            background: #FFFFFF;
            border: none;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(158, 107, 117, 0.04);
            border: 1px solid rgba(226, 219, 216, 0.4);
            padding: 30px;
            margin-bottom: 30px;
        }

        .bakery-cart-table { border-collapse: separate; border-spacing: 0; }

        .bakery-cart-table thead th {
            background-color: var(--bg-light) !important;
            color: var(--text-dark) !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            padding: 16px;
            border-bottom: 2px solid var(--accent-pink) !important;
            border-top: none !important;
        }

        .bakery-cart-table tbody td {
            padding: 20px 16px;
            border-bottom: 1px solid #F2EAE7 !important;
        }

        .cart-img-box {
            width: 70px; height: 70px;
            background-color: var(--bg-light);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
            border: 1px solid rgba(226, 219, 216, 0.3);
        }

        .cart-img-placeholder { font-size: 1.8rem; color: var(--active-pink-bg); }

        .cart-qty-input {
            max-width: 70px;
            text-align: center;
            border: 1.5px solid #E2DBD8 !important;
            border-radius: 10px !important;
            font-size: 0.9rem;
            font-weight: 600;
        }
        .cart-qty-input:focus { border-color: var(--primary-bakery) !important; box-shadow: none !important; }

        .btn-cart-remove {
            color: #DC3545; background: transparent; border: none;
            padding: 6px 12px; font-size: 0.9rem; transition: all 0.2s;
        }
        .btn-cart-remove:hover { color: #BD2130; transform: scale(1.1); }

        /* ===== Order Summary Box ===== */
        .cart-summary-box {
            background-color: #FFFFFF;
            border-radius: 20px;
            padding: 28px 32px;
            min-width: 340px;
            border: 1px solid rgba(226, 219, 216, 0.5);
            box-shadow: 0 8px 30px rgba(158, 107, 117, 0.06);
        }

        .summary-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--text-dark);
            border-bottom: 1.5px solid var(--accent-pink);
            padding-bottom: 14px;
            margin-bottom: 16px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            font-size: 0.95rem;
            color: var(--text-dark);
        }

        .summary-row .label { color: var(--text-muted); }
        .summary-row .value { font-weight: 600; }
        .summary-row.discount-row .value { color: #28A745; }

        .summary-divider { border: none; border-top: 1px dashed #E2DBD8; margin: 12px 0; }

        .summary-row.grand-total {
            padding-top: 12px;
            font-size: 1.05rem;
        }
        .summary-row.grand-total .label { font-weight: 700; color: var(--text-dark); }
        .summary-row.grand-total .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-bakery);
        }

        /* ===== Coupon Input ===== */
        .coupon-section { margin-bottom: 20px; }

        .coupon-input-group {
            display: flex;
            gap: 8px;
        }

        .coupon-input {
            flex: 1;
            border: 1.5px solid #E2DBD8;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .coupon-input:focus { border-color: var(--primary-bakery); }

        .btn-apply-coupon {
            background-color: var(--primary-bakery);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: background-color 0.2s;
        }
        .btn-apply-coupon:hover { background-color: var(--primary-hover); }

        .coupon-feedback { font-size: 0.82rem; margin-top: 6px; min-height: 1.2em; }
        .coupon-feedback.success { color: #28A745; }
        .coupon-feedback.error   { color: #DC3545; }

        /* ===== Action Buttons ===== */
        .btn-bakery-checkout {
            background-color: var(--primary-bakery);
            color: #FFFFFF;
            border: none;
            border-radius: 12px;
            padding: 14px 32px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            justify-content: center;
        }
        .btn-bakery-checkout:hover {
            background-color: var(--primary-hover);
            color: #FFFFFF;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(158, 107, 117, 0.2);
        }

        .btn-bakery-clear {
            background-color: transparent;
            color: var(--text-muted);
            border: 1.5px solid #E2DBD8;
            border-radius: 12px;
            padding: 11px 24px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-bakery-clear:hover { background-color: #FFF2F4; color: #DC3545; border-color: #FFDFE2; }

        .empty-cart-box {
            background: #FFFFFF;
            border-radius: 24px;
            padding: 60px;
            text-align: center;
            box-shadow: 0 6px 24px rgba(158, 107, 117, 0.02);
            border: 1px solid rgba(226, 219, 216, 0.4);
        }
    </style>

    <div class="container py-5">

        <div class="mb-4">
            <h2 class="cart-title mb-1"><i class="fa-solid fa-basket-shopping text-muted me-2"></i>Giỏ hàng của bạn</h2>
            <p class="text-muted small">Kiểm tra lại danh sách bánh ngọt bạn đã chọn trước khi tiến hành đặt hàng.</p>
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="empty-cart-box">
                <div class="text-muted mb-3" style="font-size: 4rem; color: var(--active-pink-bg) !important;">
                    <i class="fa-solid fa-cookie-bite"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">Giỏ hàng đang trống rỗng</h4>
                <p class="text-muted small mb-4">Hương vị ngọt ngào đang chờ đợi bạn! Hãy chọn cho mình những món bánh yêu thích nhé.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-bakery-checkout" style="width:auto;">
                    <i class="fa-solid fa-arrow-left-long"></i> Tiếp tục chọn bánh
                </a>
            </div>
        }
        else
        {
            <!-- Bảng sản phẩm -->
            <div class="card bakery-cart-card">
                <div class="table-responsive">
                    <table class="table align-middle bakery-cart-table mb-0">
                        <thead>
                            <tr>
                                <th width="100">Hình ảnh</th>
                                <th>Sản phẩm</th>
                                <th width="140">Đơn giá</th>
                                <th width="180">Số lượng</th>
                                <th width="150">Thành tiền</th>
                                <th width="90" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="cart-img-box">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" style="width:100%;height:100%;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="cart-img-placeholder"><i class="fa-solid fa-ice-cream"></i></div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="fw-bold text-dark d-block" style="font-size: 1rem;">@item.Name</span>
                                        <span class="text-muted small">Món ngọt Premium</span>
                                    </td>

                                    <td class="fw-semibold text-secondary">
                                        @item.Price.ToString("N0") <span class="small text-muted">đ</span>
                                    </td>

                                    <td>
                                        <div class="input-group input-group-sm" style="max-width: 140px;">
                                            <input type="number"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   data-product-id="@item.ProductId"
                                                   class="form-control cart-qty-input txt-quantity" />
                                        </div>
                                    </td>

                                    <td class="fw-bold item-line-total" data-product-id="@item.ProductId" style="color: var(--primary-bakery);">
                                        @((item.Price * item.Quantity).ToString("N0")) <span class="small fw-normal text-muted">đ</span>
                                    </td>

                                    <td class="text-center">
                                        <button class="btn-cart-remove btn-remove-ajax"
                                                data-product-id="@item.ProductId"
                                                data-url="@Url.Action("RemoveFromCart", "ShoppingCart")"
                                                title="Xóa món này khỏi giỏ">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Hành động + Tóm tắt đơn hàng -->
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-4 mt-2">

                <!-- Nút trái -->
                <div class="d-flex flex-wrap gap-2 align-items-start pt-1">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-bakery-clear" style="color: var(--primary-bakery);">
                        <i class="fa-solid fa-arrow-left"></i> Thêm món khác
                    </a>
                    <a asp-action="ClearCart" class="btn btn-bakery-clear">
                        <i class="fa-regular fa-circle-xmark"></i> Xóa toàn bộ giỏ
                    </a>
                </div>

                <!-- Bảng tóm tắt đơn hàng -->
                <div class="cart-summary-box">
                    <div class="summary-title"><i class="fa-solid fa-receipt me-2 text-muted"></i>Tóm tắt đơn hàng</div>

                    <!-- Mã giảm giá -->
                    <div class="coupon-section">
                        <div class="coupon-input-group">
                            <input type="text" id="couponCode" class="coupon-input" placeholder="Nhập mã khuyến mãi...">
                            <button class="btn-apply-coupon" onclick="applyCoupon()">
                                <i class="fa-solid fa-tag me-1"></i> Áp dụng
                            </button>
                        </div>
                        <div id="couponFeedback" class="coupon-feedback"></div>
                    </div>

                    <!-- Chi tiết giá -->
                    <div class="summary-row">
                        <span class="label">Tổng tiền hàng</span>
                        <span class="value" id="subtotal-amount">@Model.GetTotal().ToString("N0") đ</span>
                    </div>

                    <div class="summary-row">
                        <span class="label">Phí vận chuyển</span>
                        <span class="value" id="shipping-amount">@Model.ShippingFee.ToString("N0") đ</span>
                    </div>

                    <div class="summary-row discount-row" id="discount-row" style="@(Model.Discount > 0 ? "" : "display:none;")">
                        <span class="label"><i class="fa-solid fa-circle-check me-1"></i>Giảm giá</span>
                        <span class="value" id="discount-amount">- @Model.Discount.ToString("N0") đ</span>
                    </div>

                    <hr class="summary-divider" />

                    <div class="summary-row grand-total">
                        <span class="label">Tổng thanh toán</span>
                        <span class="value" id="cart-total-amount">@Model.GetGrandTotal().ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></span>
                    </div>

                    <div class="mt-4">
                        <a asp-action="Checkout" class="btn btn-bakery-checkout shadow-sm">
                            Tiến hành đặt hàng <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </div>
                </div>

            </div>
        }
    </div>

    @section Scripts {
    <script>
        // ================================================
        // 1. Cập nhật số lượng (AJAX)
        // ================================================
        $(document).on('change', '.txt-quantity', function () {
            var input = $(this);
            var pId = input.data('product-id');
            var qty = parseInt(input.val());
            if (qty < 1) { qty = 1; input.val(1); }

            $.ajax({
                url: '@Url.Action("UpdateQuantity", "ShoppingCart")',
                type: 'POST',
                data: { productId: pId, quantity: qty },
                success: function (res) {
                    // Cập nhật thành tiền từng dòng
                    $('.item-line-total[data-product-id="' + pId + '"]')
                        .html(res.lineTotal);

                    // Cập nhật tổng tiền hàng (subtotal)
                    var subtotal = res.cartTotal.replace(' đ', '');
                    $('#subtotal-amount').text(res.cartTotal);

                    // Tính lại grand total ở client (subtotal + ship - discount)
                    refreshGrandTotal();
                }
            });
        });

        // ================================================
        // 2. Xóa sản phẩm (AJAX)
        // ================================================
        $(document).on('click', '.btn-remove-ajax', function (e) {
            e.preventDefault();
            var btn = $(this);
            var pId = btn.data('product-id');
            var url = btn.data('url');

            $.ajax({
                url: url,
                type: 'POST',
                data: { productId: pId },
                success: function (res) {
                    btn.closest('tr').fadeOut(300, function () { $(this).remove(); });
                    $('#subtotal-amount').text(res.cartTotal);
                    refreshGrandTotal();
                }
            });
        });

        // ================================================
        // 3. Áp dụng mã giảm giá (AJAX)
        // ================================================
        function applyCoupon() {
            var code = $('#couponCode').val().trim();
            if (!code) {
                showCouponFeedback('Vui lòng nhập mã khuyến mãi.', false);
                return;
            }

            $.ajax({
                url: '@Url.Action("ApplyCoupon", "ShoppingCart")',
                type: 'POST',
                data: { couponCode: code },
                success: function (res) {
                    if (res.success) {
                        // Hiển thị dòng giảm giá
                        var discountText = '- ' + formatCurrency(res.discount) + ' đ';
                        $('#discount-amount').text(discountText);
                        $('#discount-row').show();

                        // Cập nhật tổng thanh toán
                        $('#cart-total-amount').html(formatCurrency(res.grandTotal) + ' <span class="fs-6 fw-normal text-muted">đ</span>');

                        showCouponFeedback('✓ Áp dụng mã thành công!', true);
                    } else {
                        $('#discount-row').hide();
                        showCouponFeedback('✗ ' + (res.message || 'Mã không hợp lệ.'), false);
                        refreshGrandTotal();
                    }
                }
            });
        }

        // ================================================
        // Helpers
        // ================================================
        function showCouponFeedback(msg, isSuccess) {
            var el = $('#couponFeedback');
            el.text(msg)
              .removeClass('success error')
              .addClass(isSuccess ? 'success' : 'error');
        }

        function formatCurrency(value) {
            return Math.round(value).toLocaleString('vi-VN');
        }

        // Tính lại grand total dựa trên DOM hiện tại
        function refreshGrandTotal() {
            var subtotalText = $('#subtotal-amount').text().replace(/[^0-9]/g, '');
            var shippingText = $('#shipping-amount').text().replace(/[^0-9]/g, '');
            var discountText = $('#discount-row').is(':visible')
                ? $('#discount-amount').text().replace(/[^0-9]/g, '')
                : '0';

            var subtotal = parseInt(subtotalText) || 0;
            var shipping = parseInt(shippingText) || 0;
            var discount = parseInt(discountText) || 0;
            var grand = subtotal + shipping - discount;

            $('#cart-total-amount').html(formatCurrency(grand) + ' <span class="fs-6 fw-normal text-muted">đ</span>');
        }

        // Cho phép nhấn Enter trong ô mã giảm giá
        $('#couponCode').on('keypress', function (e) {
            if (e.which === 13) applyCoupon();
        });
    </script>
    }
