@model IEnumerable<WebDoNgot.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var currentStatus = ViewBag.CurrentStatus as string;
    var allStatuses   = ViewBag.AllStatuses as string[];

    string BadgeClass(string s) => s switch {
        "Đã giao"    => "badge-delivered",
        "Đã gửi"     => "badge-shipped",
        "Đang xử lý" => "badge-processing",
        "Đã hủy"     => "badge-cancelled",
        _            => "badge-processing"
    };
    string BadgeIcon(string s) => s switch {
        "Đã giao"    => "fa-circle-check",
        "Đã gửi"     => "fa-truck",
        "Đang xử lý" => "fa-clock",
        "Đã hủy"     => "fa-circle-xmark",
        _            => "fa-clock"
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary: #9E6B75; --primary-hover: #855660;
        --accent: #F7EBEF;  --accent-dark: #E8C5CC;
        --text: #4A3E41;    --muted: #8A7A7D;
        --bg: #FAF7F5;
    }
    body { background: #FCF9F7; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text); }

    /* ── Page Header ── */
    .page-title { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.9rem; color: var(--text); }

    /* ── KPI Cards ── */
    .kpi-card {
        background: #fff; border-radius: 18px; padding: 20px 24px;
        border: 1px solid rgba(226,219,216,.5);
        box-shadow: 0 6px 24px rgba(158,107,117,.04);
        display: flex; align-items: center; gap: 16px;
    }
    .kpi-icon {
        width: 52px; height: 52px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .kpi-icon.total      { background: #F0F4FF; color: #4A6CF7; }
    .kpi-icon.processing { background: #FFF8EC; color: #F59E0B; }
    .kpi-icon.shipped    { background: #EEF9FF; color: #0EA5E9; }
    .kpi-icon.delivered  { background: #EDFDF8; color: #10B981; }
    .kpi-icon.cancelled  { background: #FEF2F2; color: #EF4444; }
    .kpi-number { font-size: 1.6rem; font-weight: 700; color: var(--text); line-height: 1; }
    .kpi-label  { font-size: 0.82rem; color: var(--muted); font-weight: 500; }

    /* ── Filter Tabs ── */
    .filter-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
    .filter-btn {
        padding: 8px 18px; border-radius: 30px; font-size: 0.88rem; font-weight: 600;
        text-decoration: none; border: 1.5px solid #E2DBD8; color: var(--muted);
        background: #fff; transition: all .2s;
    }
    .filter-btn:hover, .filter-btn.active {
        background: var(--primary); color: #fff; border-color: var(--primary);
    }
    .filter-btn.active { box-shadow: 0 4px 14px rgba(158,107,117,.25); }

    /* ── Table Card ── */
    .table-card {
        background: #fff; border-radius: 20px; overflow: hidden;
        border: 1px solid rgba(226,219,216,.4);
        box-shadow: 0 8px 30px rgba(158,107,117,.04);
    }
    .table-card table { margin: 0; }
    .table-card thead th {
        background: var(--bg) !important; color: var(--text) !important;
        font-weight: 600; font-size: 0.8rem; text-transform: uppercase;
        letter-spacing: .5px; padding: 14px 16px;
        border-bottom: 2px solid var(--accent) !important; border-top: none !important;
    }
    .table-card tbody td { padding: 14px 16px; border-bottom: 1px solid #F2EAE7 !important; vertical-align: middle; }
    .table-card tbody tr:last-child td { border-bottom: none !important; }

    /* ── Status Badges ── */
    .status-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
    }
    .badge-processing { background: #FFF8EC; color: #B45309; }
    .badge-shipped    { background: #EEF9FF; color: #0369A1; }
    .badge-delivered  { background: #EDFDF8; color: #047857; }
    .badge-cancelled  { background: #FEF2F2; color: #B91C1C; }

    /* ── Status Dropdown ── */
    .status-select {
        border: 1.5px solid #E2DBD8; border-radius: 8px;
        padding: 5px 10px; font-size: 0.83rem; font-weight: 600;
        cursor: pointer; color: var(--text); background: #fff;
        outline: none; transition: border-color .2s;
    }
    .status-select:focus { border-color: var(--primary); }

    /* ── Links ── */
    .btn-detail {
        color: var(--primary); font-size: 0.85rem; font-weight: 600;
        text-decoration: none; padding: 5px 12px; border-radius: 8px;
        border: 1.5px solid var(--accent-dark); transition: all .2s;
    }
    .btn-detail:hover { background: var(--accent); color: var(--primary-hover); }

    .btn-dashboard {
        background: var(--primary); color: #fff; border: none;
        border-radius: 12px; padding: 10px 20px; font-weight: 600;
        font-size: 0.9rem; text-decoration: none; display: inline-flex;
        align-items: center; gap: 6px; transition: all .2s;
    }
    .btn-dashboard:hover { background: var(--primary-hover); color: #fff; transform: translateY(-1px); }

    .empty-box {
        text-align: center; padding: 60px 20px; color: var(--muted);
    }
    .empty-box .icon { font-size: 3.5rem; color: var(--accent-dark); margin-bottom: 16px; }
</style>

<div class="container-fluid py-4 px-4">

    <!-- Header -->
        <div class="mb-4">
        <a asp-controller="Product" asp-action="Index" class="btn btn-bakery-back px-3 py-2">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="page-title mb-1"><i class="fa-solid fa-list-check me-2 text-muted"></i>Quản lý đơn hàng</h2>
            <p class="text-muted small mb-0">Theo dõi và cập nhật trạng thái các giao dịch của khách hàng.</p>
        </div>
        <a asp-action="RevenueDashboard" class="btn-dashboard">
            <i class="fa-solid fa-chart-line"></i> Dashboard Doanh thu
        </a>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card">
                <div class="kpi-icon total"><i class="fa-solid fa-receipt"></i></div>
                <div>
                    <div class="kpi-number">@ViewBag.TotalOrders</div>
                    <div class="kpi-label">Tất cả</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card">
                <div class="kpi-icon processing"><i class="fa-solid fa-clock"></i></div>
                <div>
                    <div class="kpi-number">@ViewBag.ProcessingCount</div>
                    <div class="kpi-label">Đang xử lý</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card">
                <div class="kpi-icon shipped"><i class="fa-solid fa-truck"></i></div>
                <div>
                    <div class="kpi-number">@ViewBag.ShippedCount</div>
                    <div class="kpi-label">Đã gửi</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card">
                <div class="kpi-icon delivered"><i class="fa-solid fa-circle-check"></i></div>
                <div>
                    <div class="kpi-number">@ViewBag.DeliveredCount</div>
                    <div class="kpi-label">Đã giao</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card">
                <div class="kpi-icon cancelled"><i class="fa-solid fa-circle-xmark"></i></div>
                <div>
                    <div class="kpi-number">@ViewBag.CancelledCount</div>
                    <div class="kpi-label">Đã hủy</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-bar">
        <a href="@Url.Action("OrderManagement")" class="filter-btn @(currentStatus == null ? "active" : "")">
            <i class="fa-solid fa-border-all me-1"></i> Tất cả
        </a>
        @foreach (var s in allStatuses)
        {
            <a href="@Url.Action("OrderManagement", new { status = s })"
               class="filter-btn @(currentStatus == s ? "active" : "")">
                <i class="fa-solid @BadgeIcon(s) me-1"></i> @s
            </a>
        }
    </div>

    <!-- Table -->
    <div class="table-card">
        @if (!Model.Any())
        {
            <div class="empty-box">
                <div class="icon"><i class="fa-solid fa-inbox"></i></div>
                <p class="fw-semibold mb-1">Không có đơn hàng nào</p>
                <p class="small">Chưa có đơn hàng ở trạng thái này.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Sản phẩm</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold" style="color: var(--primary);">#@order.Id</td>
                                <td>
                                    <div class="fw-semibold">@(order.ApplicationUser?.FullName ?? order.ApplicationUser?.Email ?? "—")</div>
                                    <div class="text-muted small">@(order.ApplicationUser?.Email ?? "")</div>
                                </td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy")<br/>@order.OrderDate.ToString("HH:mm")</td>
                                <td>
                                    <span class="text-muted small">@order.OrderDetails.Count món</span>
                                    <div class="fw-semibold small">@order.OrderDetails.Sum(x => x.Quantity) sản phẩm</div>
                                </td>
                                <td class="text-end fw-bold" style="color: var(--primary);">
                                    @order.TotalPrice.ToString("N0") đ
                                </td>
                                <td class="text-center">
                                    <span class="status-badge @BadgeClass(order.Status)" id="badge-@order.Id">
                                        <i class="fa-solid @BadgeIcon(order.Status)"></i> @order.Status
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <select class="status-select"
                                                data-order-id="@order.Id"
                                                onchange="updateStatus(this)">
                                            @foreach (var s in allStatuses)
                                            {
                                                @if (order.Status == s)
                                                {
                                                    <option value="@s" selected="selected">@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                        <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn-detail">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    const statusClasses = {
        "Đang xử lý": { badge: "badge-processing", icon: "fa-clock" },
        "Đã gửi":     { badge: "badge-shipped",    icon: "fa-truck" },
        "Đã giao":    { badge: "badge-delivered",  icon: "fa-circle-check" },
        "Đã hủy":     { badge: "badge-cancelled",  icon: "fa-circle-xmark" }
    };

    function updateStatus(selectEl) {
        const orderId   = selectEl.dataset.orderId;
        const newStatus = selectEl.value;

        fetch('@Url.Action("UpdateOrderStatus")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `orderId=${orderId}&newStatus=${encodeURIComponent(newStatus)}`
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                const info  = statusClasses[newStatus] || statusClasses["Đang xử lý"];
                const badge = document.getElementById('badge-' + orderId);
                badge.className = `status-badge ${info.badge}`;
                badge.innerHTML = `<i class="fa-solid ${info.icon}"></i> ${newStatus}`;
            }
        });
    }
</script>
}
