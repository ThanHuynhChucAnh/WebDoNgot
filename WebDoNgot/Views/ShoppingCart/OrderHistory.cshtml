@model IEnumerable<WebDoNgot.Models.Order>

@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-bakery: #9E6B75;
        --primary-hover: #855660;
        --accent-pink: #F7EBEF;
        --active-pink-bg: #E8C5CC;
        --text-dark: #4A3E41;
        --text-muted: #8A7A7D;
        --bg-light: #FAF7F5;
    }

    body {
        background-color: #FCF9F7;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-dark);
    }

    .order-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--text-dark);
        font-size: 2rem;
    }

    .bakery-order-card {
        background: #FFFFFF;
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(158, 107, 117, 0.04);
        border: 1px solid rgba(226, 219, 216, 0.4);
        padding: 30px;
        margin-bottom: 35px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .bakery-order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 45px rgba(158, 107, 117, 0.08);
        }

    .info-label {
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        color: var(--text-dark);
        font-weight: 600;
        font-size: 1rem;
    }

    .bakery-order-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .bakery-order-table thead th {
            background-color: var(--bg-light) !important;
            color: var(--text-dark) !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            padding: 14px 16px;
            border-bottom: 2px solid var(--accent-pink) !important;
            border-top: none !important;
        }

        .bakery-order-table tbody td {
            padding: 16px;
            border-bottom: 1px solid #F2EAE7 !important;
        }

    .bakery-product-img {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #F2EAE7;
        box-shadow: 0 4px 10px rgba(158, 107, 117, 0.05);
    }

    /* ===== Summary box ===== */
    .order-summary-box {
        background-color: var(--bg-light);
        border-radius: 16px;
        padding: 20px 24px;
        min-width: 300px;
        border: 1px solid rgba(226, 219, 216, 0.5);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 0;
        font-size: 0.92rem;
    }

        .summary-row .label {
            color: var(--text-muted);
        }

        .summary-row .value {
            font-weight: 600;
            color: var(--text-dark);
        }

        .summary-row.discount-row .value {
            color: #28A745;
        }

    .summary-divider {
        border: none;
        border-top: 1px dashed #E2DBD8;
        margin: 10px 0;
    }

    .summary-row.grand-total .label {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1rem;
        color: var(--text-dark);
    }

    .summary-row.grand-total .value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--primary-bakery);
    }

    .btn-bakery-back {
        background-color: transparent;
        color: var(--text-muted);
        border: 1.5px solid #E2DBD8;
        border-radius: 12px;
        padding: 11px 24px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-bakery-back:hover {
            background-color: var(--accent-pink);
            color: var(--primary-bakery);
            border-color: var(--active-pink-bg);
        }
</style>

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="Product" asp-action="Index" class="btn btn-bakery-back px-3 py-2">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>

    <div class="mb-5 text-center text-sm-start">
        <h2 class="order-title mb-1">
            <i class="fa-solid fa-clock-rotate-left text-muted me-2"></i>Lịch sử mua hàng
        </h2>
        <p class="text-muted small mb-0">Xem lại danh sách những hương vị ngọt ngào bạn đã từng đặt mua tại tiệm bánh.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 card bakery-order-card">
            <div class="mb-3 text-muted" style="font-size: 3.5rem;"><i class="fa-solid fa-cookie"></i></div>
            <h4 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">Bạn chưa có đơn hàng nào</h4>
            <p class="text-muted mb-4">Các món bánh Premium thơm ngon đang chờ đợi để được phục vụ bạn.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-bakery-back" style="background-color: var(--primary-bakery); color: white; border: none;">
                    <i class="fa-solid fa-basket-shopping"></i> Khám phá cửa hàng ngay
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card bakery-order-card">

                <!-- Header đơn hàng -->
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                    <h5 class="mb-0 fw-bold" style="color: var(--primary-bakery);">
                        <i class="fa-solid fa-receipt me-2"></i>Đơn hàng @order.Id
                    </h5>
                    <span class="badge px-3 py-2 rounded-pill" style="background-color: var(--accent-pink); color: var(--primary-bakery);">
                        <i class="fa-solid fa-calendar-day me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <!-- Địa chỉ & ghi chú -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="info-label mb-1"><i class="fa-solid fa-location-dot me-1"></i> Địa chỉ giao:</div>
                        <div class="info-value">@order.ShippingAddress</div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label mb-1"><i class="fa-regular fa-comment-dots me-1"></i> Ghi chú:</div>
                        <div class="info-value text-muted" style="font-weight:500;">
                            @(string.IsNullOrEmpty(order.Notes) ? "Không có ghi chú" : order.Notes)
                        </div>
                    </div>
                </div>

                <!-- Bảng sản phẩm -->
                <div class="table-responsive">
                    <table class="table align-middle bakery-order-table mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.Product?.ImageUrl" class="bakery-product-img me-3" />
                                            <span class="fw-semibold">@(item.Product?.Name ?? "Sản phẩm")</span>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("N0") đ</td>
                                    <td class="text-end fw-bold" style="color: var(--primary-bakery);">
                                        @((item.Quantity * item.Price).ToString("N0")) đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Tóm tắt tiền -->
                <div class="d-flex justify-content-end mt-4">
                    <div class="order-summary-box">

                        <div class="summary-row">
                            <span class="label">Tổng tiền hàng</span>
                            <span class="value">@order.OrderDetails.Sum(x => x.Price * x.Quantity).ToString("N0") đ</span>
                        </div>

                        <div class="summary-row">
                            <span class="label">Phí vận chuyển</span>
                            <span class="value">@order.ShippingFee.ToString("N0") đ</span>
                        </div>

                        @if (order.Discount > 0)
                        {
                            <div class="summary-row discount-row">
                                <span class="label"><i class="fa-solid fa-circle-check me-1"></i>Giảm giá</span>
                                <span class="value">- @order.Discount.ToString("N0") đ</span>
                            </div>
                        }

                        <hr class="summary-divider" />

                        <div class="summary-row grand-total">
                            <span class="label">Tổng thanh toán</span>
                            <span class="value">@order.TotalPrice.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></span>
                        </div>

                    </div>
                </div>

            </div>
        }
    }

</div>
